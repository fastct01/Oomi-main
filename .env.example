# Copy to .env (never commit .env) and fill in.

# Claude
ANTHROPIC_API_KEY=

# MongoDB Atlas: Connect → Drivers → Python. Database user with "Read and write to any database".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
OOMI_DB=oomi

# Everyone on the same team shares antibodies.
OOMI_TEAM=encode-london
OOMI_USER=Ivan

# Optional: Voyage AI key for reranking matches (see README). Leave empty to skip reranking.
VOYAGE_API_KEY=

# ask = approve every edit and command; project = edits and test commands run freely; auto = only risky commands ask
OOMI_TRUST=project
